---
import { GITHUB_URL } from "../../lib/site";

const base = import.meta.env.BASE_URL;

const pages = [
  { label: "App", href: base + "app" },
  { label: "Sample plans", href: base + "samples" },
  { label: "FAQ", href: base + "faq" },
  { label: "Blog", href: base + "blog" },
];

const legal = [
  { label: "Privacy", href: base + "privacy" },
  { label: "Terms", href: base + "terms" },
  { label: "GitHub", href: GITHUB_URL },
];

const linkClass =
  "text-ink-soft hover:text-ink flex items-center py-1.5 text-[14px] [@media(pointer:coarse)]:min-h-11";
---

<footer class="section-dim">
  <div class="wrap pt-14 pb-10">
    <div class="grid gap-10 min-[980px]:grid-cols-[1.6fr_1fr_1fr]">
      <div>
        <p
          class="font-display flex items-center gap-2.5 text-[18px] font-bold tracking-[-0.02em] lowercase"
        >
          <img src={base + "favicon.svg"} width="22" height="22" alt="" />kampa
        </p>
        <p class="text-ink-soft mt-3 max-w-[260px] text-[13.8px]">
          Free AI campaign planner for small businesses.
        </p>
      </div>

      <div>
        <h2 class="mono-label">Pages</h2>
        <ul>
          {
            pages.map((link) => (
              <li>
                <a class={linkClass} href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="mono-label">Legal</h2>
        <ul>
          {
            legal.map((link) => (
              <li>
                <a class={linkClass} href={link.href} rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="border-line text-ink-soft mt-11 border-t pt-[22px] text-[12.5px]">
      © 2026 Kampa.
    </p>
  </div>

  <div class="overflow-hidden" aria-hidden="true">
    <p
      class="font-display text-[18vw] leading-[0.8] font-bold tracking-[-0.04em] lowercase"
      style="color: color-mix(in oklab, var(--ink) 6%, transparent)"
    >
      kampa
    </p>
  </div>
</footer>
