---
import Ring from "./Ring.astro";

const base = import.meta.env.BASE_URL;

const channels = [
  { name: "Instagram", cadence: "3 posts/week" },
  { name: "Google Business Profile", cadence: "weekly" },
  { name: "Email", cadence: "bi-weekly" },
];
---

<section
  class="wrap grid items-center gap-14 pt-[76px] pb-16 min-[980px]:grid-cols-[1.05fr_0.95fr]"
>
  <div>
    <p class="eyebrow">AI campaign planner</p>

    <h1 class="text-[length:var(--text-h1)] leading-[var(--lh-h1)]">
      A real marketing plan.<br />For your budget.<br />In 15 minutes.
    </h1>

    <p
      class="text-ink-soft mt-[22px] max-w-[480px] text-[length:var(--text-lead)]"
    >
      Kampa interviews you like a strategist — your business, your budget, your
      hours — then builds a complete 30-day campaign and checks it for risk
      before you spend a euro.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3.5">
      <a class="btn btn-grad" href={base + "app"}>
        Start a campaign <span aria-hidden="true">→</span>
      </a>
      <a class="btn btn-ghost" href="#samples">See a sample plan</a>
    </div>

    <p class="text-ink-soft mt-5 text-[13px]">
      No signup. No servers. Your data and API key never leave your browser.
      Free software — you pay Anthropic ~€1 per campaign.
    </p>
  </div>

  {
    /* Proof, not a screenshot: a finished campaign package, enlarged, as the
       first thing seen. Decorative — every figure in it is stated in prose
       elsewhere on the page. */
  }
  <div class="card p-[26px]" aria-hidden="true">
    <div class="flex items-start justify-between gap-4">
      <div>
        <span
          class="text-ink-soft font-mono text-[length:var(--text-mono-label)] font-semibold tracking-[0.09em] uppercase"
        >
          30-day campaign
        </span>
        <p
          class="font-display mt-1.5 text-[19px] font-semibold tracking-[-0.02em]"
        >
          Riga coffee shop
        </p>
      </div>

      <Ring size={64} r={26} sw={7} dash={163} offset={38}>
        <b>€1</b><i>cost</i>
      </Ring>
    </div>

    <ul class="mt-5 flex flex-col gap-[11px] text-[14.5px]">
      {
        channels.map((channel) => (
          <li class="flex items-baseline gap-2.5">
            <span class="mt-0 size-[5px] flex-none -translate-y-0.5 rounded-full bg-[image:var(--grad)]" />
            <span>
              <b class="font-semibold">{channel.name}</b> — {channel.cadence}
            </span>
          </li>
        ))
      }
    </ul>

    <div class="mt-5 flex flex-wrap gap-2">
      <span class="chip">+40 followers/mo</span>
      <span class="chip">≤ 4 h/week</span>
      <span class="chip chip-grad">1 risk flagged</span>
    </div>

    <p class="text-ink-soft mt-4 text-[length:var(--text-xs)]">
      + company &amp; market risk charts, included in every plan
    </p>
  </div>
</section>

<div class="stripband">
  <p>Built for small businesses that do their own marketing</p>
</div>
