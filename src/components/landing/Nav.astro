---
import { GITHUB_URL as githubUrl } from "../../lib/site";

const base = import.meta.env.BASE_URL;

const links = [
  { label: "How it works", href: base + "#how-it-works" },
  { label: "FAQ", href: base + "faq" },
];

const linkClass = "text-[14.5px] font-medium text-ink-soft hover:text-ink";
---

<header class="bar-blur border-line sticky top-0 z-50 border-b">
  <nav class="wrap flex h-[72px] items-center justify-between gap-5">
    <a
      href={base}
      class="font-display flex items-center gap-2.5 text-[19px] font-bold tracking-[-0.02em] lowercase"
    >
      <img src={base + "favicon.svg"} width="26" height="26" alt="" />kampa
    </a>

    <div class="hidden items-center gap-[30px] min-[980px]:flex">
      {
        links.map((link) => (
          <a href={link.href} class={linkClass}>
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="text-ink-soft hover:text-ink hidden min-h-11 min-w-11 items-center justify-center rounded-full min-[980px]:inline-flex"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>

      <a
        class="btn btn-ghost btn-sm hidden min-[980px]:inline-flex"
        href={base + "blog"}>Blog</a
      >
      <a class="btn btn-primary btn-sm" href={base + "app"}>Open the app</a>

      {
        /* ponytail: native <details> disclosure — no client JS, and it is
           absent above 980px so it adds no desktop tab stop. */
      }
      <details class="min-[980px]:hidden">
        <summary
          class="text-ink -mr-2 inline-flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-full [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">Menu</span>
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>

        {
          /* Opaque, not .bar-blur: a backdrop-filter nested inside the
             blurred header never composites, so the panel read straight
             through onto the hero. */
        }
        <div
          class="bg-paper border-line absolute inset-x-0 top-full flex flex-col items-start gap-1 border-b px-[var(--pad-wrap-x)] py-4"
        >
          {
            [...links, { label: "Blog", href: base + "blog" }].map((link) => (
              <a
                href={link.href}
                class={`${linkClass} flex min-h-11 items-center`}
              >
                {link.label}
              </a>
            ))
          }
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener"
            class={`${linkClass} flex min-h-11 items-center`}
          >
            GitHub
          </a>
        </div>
      </details>
    </div>
  </nav>
</header>
