---
import { GITHUB_URL as githubUrl } from "../../lib/site";

const base = import.meta.env.BASE_URL;

const links = [
  { label: "How it works", href: base + "#how-it-works" },
  { label: "FAQ", href: base + "faq" },
  { label: "Blog", href: base + "blog" },
];
---

<header class="sticky top-0 z-50 border-b border-neutral-200 bg-white">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6"
    aria-label="Main"
  >
    <a
      href={base}
      class="text-xl font-bold tracking-tight text-neutral-950 lowercase"
      >kampa</a
    >

    {
      /* ponytail: CSS-only mobile menu — hidden checkbox + label, no client JS */
    }
    <input
      id="nav-toggle"
      type="checkbox"
      class="peer sr-only"
      aria-label="Menu"
    />

    <label
      for="nav-toggle"
      class="-mr-2 cursor-pointer rounded-md p-2 text-neutral-950 md:hidden"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </label>

    <div
      class="flex items-center gap-8 max-md:absolute max-md:inset-x-0 max-md:top-full max-md:hidden max-md:flex-col max-md:items-start max-md:gap-5 max-md:border-b max-md:border-neutral-200 max-md:bg-white max-md:px-6 max-md:py-6 max-md:peer-checked:flex"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-neutral-700 hover:text-neutral-950"
          >
            {link.label}
          </a>
        ))
      }

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="text-neutral-700 hover:text-neutral-950"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>

      <a
        href={base + "app"}
        class="bg-primary text-primary-foreground inline-flex items-center rounded-lg px-4 py-2 text-sm font-semibold hover:opacity-90"
      >
        Open the app
      </a>
    </div>
  </nav>
</header>
