---
const columns = ["Kampa", "ChatGPT free", "Jasper", "HubSpot"];

const rows = [
  {
    label: "Complete 30-day package",
    cells: ["Yes", "Blank prompt", "Assets only", "Partial"],
  },
  {
    label: "Flags risk before you spend",
    cells: ["Yes", "No", "No", "No"],
  },
  {
    label: "Fits your budget & hours",
    cells: ["Yes", "If you ask", "No", "No"],
  },
  {
    label: "Cost",
    cells: ["~€1/campaign", "Free, unstructured", "€59–69/mo", "€20–890/mo"],
  },
  {
    label: "Data stored on their servers",
    cells: ["No — browser only", "Yes", "Yes", "Yes"],
  },
  {
    label: "Export you own",
    cells: ["md / PDF / ics", "Copy-paste", "Limited", "Limited"],
  },
];
---

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Why not just ChatGPT?</p>
      <h2>Fair question. Here's the honest answer.</h2>
    </div>

    {
      /* overflow-x wrapper is mandatory — the body must never scroll sideways */
    }
    <div
      class="overflow-x-auto"
      tabindex="0"
      role="region"
      aria-label="Comparison table"
    >
      <table class="compare">
        <thead>
          <tr>
            <th scope="col">Capability</th>
            {
              columns.map((name, i) => (
                <th scope="col" class:list={[i === 0 && "hi"]}>
                  {name}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {row.cells.map((cell, i) => (
                  <td class:list={[i === 0 && "hi"]}>{cell}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  /* One-per-file layout: the comparison table is not a shared pattern, so it
     lives here rather than in global.css. Values are contract §6.11. */
  table.compare {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  table.compare th,
  table.compare td {
    padding: 14px 16px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  table.compare thead th {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    font-weight: 600;
    letter-spacing: var(--tracking-th);
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  table.compare tbody th {
    width: 34%;
    font-weight: 400;
    color: var(--ink-soft);
  }
  /* the Kampa column */
  table.compare .hi {
    background-color: color-mix(in oklab, var(--coral) 6%, transparent);
    color: var(--ink);
    font-weight: 600;
  }
  table.compare thead th.hi {
    background-image: var(--grad);
    background-size: 100% 2px;
    background-repeat: no-repeat;
    background-position: top left;
  }
  @media (max-width: 640px) {
    table.compare {
      font-size: var(--text-xs);
      min-width: 38rem;
    }
    table.compare th,
    table.compare td {
      padding: 12px 12px;
    }
  }
</style>
