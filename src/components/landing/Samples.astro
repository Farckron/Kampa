---
import { getCollection } from "astro:content";
import Ring from "./Ring.astro";

const base = import.meta.env.BASE_URL;
const samples = await getCollection("samples");

// ponytail: three hardcoded slugs — the collection has three entries and the
// teasers are hand-written per sample. A generator would be more code, not less.
// The find() below is the guard: rename a sample and the build fails loudly.
const cards = [
  {
    slug: "riga-coffee-shop",
    title: "Coffee shop",
    risk: "Risk check: low — 1 channel avoided",
    riskClass: "text-violet-ink",
    teasers: [
      "Instagram — €35 boosts at a 3 km radius, one dated offer per push",
      "Google Business Profile — weekly posts, reviews 62 → 90",
      "Rejected: TikTok, Google Ads, delivery apps",
    ],
  },
  {
    slug: "hair-salon",
    title: "Hair salon",
    risk: "Risk check: medium — 1 channel reduced",
    riskClass: "text-coral-ink",
    teasers: [
      "Instagram — €120/mo boosted across Jelgava + 10 km",
      "Google Business Profile — 2/3 of first bookings start on the map",
      "Rejected: TikTok, paid search, mailbox flyers",
    ],
  },
  {
    slug: "ecommerce-boutique",
    title: "Online boutique",
    risk: "Risk check: 1 high-risk channel avoided",
    riskClass: "text-orange-ink",
    teasers: [
      "Pinterest — a photo shot in August still sends clicks in March",
      "Email — the only asset that compounds on €700 and 6h/week",
      "Rejected: Meta ads, TikTok, marketplaces",
    ],
  },
].map((card) => ({
  ...card,
  href: base + "samples/" + samples.find((s) => s.id === card.slug)!.id,
  // Mockup bolds the channel name ahead of the em dash.
  lines: card.teasers.map((teaser) => {
    const [lead, ...rest] = teaser.split(" — ");
    return rest.length ? { lead, rest: rest.join(" — ") } : { rest: lead };
  }),
}));
---

<section id="samples" class="section scroll-mt-20">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">See what you get</p>
      <h2>Three businesses, three budgets.</h2>
      <p>
        Complete plans, not teasers — open any of them and read the whole thing.
      </p>
    </div>

    <div class="grid gap-[var(--gap-card)] min-[980px]:grid-cols-3">
      {
        cards.map((card) => (
          <article class="card hover:border-ink-soft relative flex flex-col p-6 transition-colors">
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-[length:var(--text-h3)] leading-[var(--lh-h3)] text-balance">
                {card.title}
              </h3>
              <Ring
                size={40}
                r={16}
                sw={5}
                dash={100}
                offset={24}
                valClass="scale-[0.72]"
              >
                <b>€1</b>
              </Ring>
            </div>

            <p
              class:list={[
                "mt-4 text-[length:var(--text-xs)] font-semibold",
                card.riskClass,
              ]}
            >
              {card.risk}
            </p>

            <ul class="mt-[18px] flex flex-col gap-2.5 text-[length:var(--text-sm)]">
              {card.lines.map((line) => (
                <li class="text-ink-soft before:text-ink-soft relative pl-6 before:absolute before:left-0 before:content-['—']">
                  {line.lead && (
                    <b class="text-ink font-semibold">{line.lead}</b>
                  )}
                  {line.lead && " — "}
                  {line.rest}
                </li>
              ))}
            </ul>

            {/* Stretched link: the whole card is the tap target, but only
                one link lands in the accessibility tree. */}
            <a
              href={card.href}
              class="text-violet-ink mt-auto inline-flex w-fit items-center gap-1.5 pt-5 text-[0.84375rem] font-semibold after:absolute after:inset-0 after:content-[''] hover:underline"
            >
              Open full sample <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-11 text-center">
      <a class="btn btn-grad" href={base + "app"}>
        Start a campaign <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
