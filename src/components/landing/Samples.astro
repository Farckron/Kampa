---
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const samples = await getCollection("samples");

// ponytail: three hardcoded slugs — the collection has three entries and the
// teasers are hand-written per sample. A generator would be more code, not less.
const cards = [
  {
    slug: "riga-coffee-shop",
    teasers: [
      "Instagram — €35 boosts at a 3 km radius, one dated morning offer per push",
      "Google Business Profile — weekly posts, reviews pushed from 62 to 90",
      "Rejected: TikTok, Google Ads, delivery apps — reach 20 seats can't serve",
    ],
  },
  {
    slug: "hair-salon",
    teasers: [
      "Instagram — €120/month boosted across Jelgava plus 10 km, nothing wider",
      "Google Business Profile — two thirds of first bookings start on the map",
      "Rejected: TikTok, paid search, mailbox flyers — wrong ages or unmeasurable",
    ],
  },
  {
    slug: "ecommerce-boutique",
    teasers: [
      "Pinterest — a photo shot in August is still sending clicks in March",
      "Email — the only asset that compounds on €700 and six hours a week",
      "Rejected: Meta ads, TikTok, marketplaces — CPA lands above gross margin",
    ],
  },
].map((card) => ({
  ...card,
  data: samples.find((sample) => sample.id === card.slug)!.data,
  // Mockup bolds the channel name ahead of the em dash.
  lines: card.teasers.map((teaser) => {
    const [lead, ...rest] = teaser.split(" — ");
    return rest.length ? { lead, rest: rest.join(" — ") } : { rest: lead };
  }),
}));
---

<section id="samples" class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Samples</p>
      <h2>See what you get</h2>
      <p>
        Three businesses, three budgets. These are complete plans, not teasers —
        open any of them and read the whole thing.
      </p>
    </div>

    <div class="grid gap-[var(--gap-card)] md:grid-cols-3">
      {
        cards.map((card) => (
          <article class="card relative flex flex-col p-6 transition-colors hover:border-ink-soft">
            <h3 class="text-[length:var(--text-h3)] leading-[var(--lh-h3)] text-balance">
              {card.data.title}
            </h3>
            <p class="mt-3 text-[length:var(--text-sm)] leading-[1.5] text-ink-soft">
              {card.data.business}
            </p>

            <dl class="mt-5">
              <div class="data-row">
                <dt>Budget</dt>
                <dd class="amt">€{card.data.budget} / mo</dd>
              </div>
              <div class="data-row">
                <dt>Owner time</dt>
                <dd class="amt">{card.data.hours} h / week</dd>
              </div>
            </dl>

            <ul class="mt-[18px] flex flex-col gap-2.5 text-[length:var(--text-sm)]">
              {card.lines.map((line) => (
                <li class="text-ink-soft before:text-ink-soft relative pl-6 before:absolute before:left-0 before:content-['—']">
                  {line.lead && (
                    <b class="text-ink font-semibold">{line.lead}</b>
                  )}
                  {line.lead && " — "}
                  {line.rest}
                </li>
              ))}
            </ul>

            <ul class="mt-5 flex flex-wrap gap-2">
              {card.data.channels.map((channel) => (
                <li class="chip">{channel}</li>
              ))}
            </ul>

            {/* Stretched link: the whole card is the tap target, but only
                one link lands in the accessibility tree. */}
            <a
              href={base + "samples/" + card.slug}
              class="mt-auto inline-flex w-fit items-center gap-1.5 pt-6 text-[0.84375rem] font-semibold text-violet-ink after:absolute after:inset-0 after:content-[''] hover:underline"
            >
              Open full sample <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-11 text-center">
      <a class="btn btn-grad" href={base + "app"}>
        Start a campaign <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
