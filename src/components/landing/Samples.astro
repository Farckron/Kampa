---
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const samples = await getCollection("samples");

// ponytail: CSS-only tabs (radio + named peers). Class strings are literal so
// Tailwind's scanner sees them; 3 hardcoded slugs beats a generator here.
const tabs = [
  {
    slug: "riga-coffee-shop",
    tab: "Coffee shop",
    teasers: [
      "Instagram — €35 boosts at a 3 km radius, one dated morning offer per push",
      "Google Business Profile — weekly posts, reviews pushed from 62 to 90",
      "Rejected: TikTok, Google Ads, delivery apps — reach 20 seats can't serve",
    ],
    peer: "peer/a",
    label:
      "peer-checked/a:border-primary peer-checked/a:text-primary peer-focus-visible/a:ring-2",
    panel: "hidden peer-checked/a:block",
  },
  {
    slug: "hair-salon",
    tab: "Hair salon",
    teasers: [
      "Instagram — €120/month boosted across Jelgava plus 10 km, nothing wider",
      "Google Business Profile — two thirds of first bookings start on the map",
      "Rejected: TikTok, paid search, mailbox flyers — wrong ages or unmeasurable",
    ],
    peer: "peer/b",
    label:
      "peer-checked/b:border-primary peer-checked/b:text-primary peer-focus-visible/b:ring-2",
    panel: "hidden peer-checked/b:block",
  },
  {
    slug: "ecommerce-boutique",
    tab: "Online boutique",
    teasers: [
      "Pinterest — a photo shot in August is still sending clicks in March",
      "Email — the only asset that compounds on €700 and six hours a week",
      "Rejected: Meta ads, TikTok, marketplaces — CPA lands above gross margin",
    ],
    peer: "peer/c",
    label:
      "peer-checked/c:border-primary peer-checked/c:text-primary peer-focus-visible/c:ring-2",
    panel: "hidden peer-checked/c:block",
  },
].map((tab) => ({
  ...tab,
  data: samples.find((sample) => sample.id === tab.slug)!.data,
}));
---

<section class="px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <h2
      class="max-w-2xl text-4xl font-extrabold tracking-tight text-balance text-neutral-950 sm:text-5xl"
    >
      See what you get
    </h2>
    <p class="mt-5 max-w-prose text-lg text-neutral-600">
      Three businesses, three budgets. These are complete plans, not teasers —
      open any of them and read the whole thing.
    </p>

    <div class="mt-12 grid gap-3 sm:grid-cols-3">
      {
        tabs.map((tab, i) => (
          <input
            type="radio"
            name="sample-tab"
            id={`sample-tab-${tab.slug}`}
            class={`${tab.peer} sr-only`}
            checked={i === 0}
          />
        ))
      }

      {
        tabs.map((tab) => (
          <label
            for={`sample-tab-${tab.slug}`}
            class:list={[
              "ring-primary/40 cursor-pointer rounded-xl border border-neutral-200 bg-white px-5 py-4 text-sm font-semibold text-neutral-600 hover:bg-neutral-50",
              tab.label,
            ]}
          >
            {tab.tab}
          </label>
        ))
      }

      {
        tabs.map((tab) => (
          <div
            class:list={[
              "rounded-xl border border-neutral-200 bg-white p-8 sm:col-span-3",
              tab.panel,
            ]}
          >
            <h3 class="text-lg font-semibold text-balance text-neutral-950">
              {tab.data.title}
            </h3>
            <p class="mt-3 max-w-prose text-neutral-600">{tab.data.business}</p>

            <div class="mt-6 flex flex-wrap gap-2">
              <span class="rounded-full border border-neutral-200 px-3 py-1 text-xs font-medium text-neutral-600">
                €{tab.data.budget}/mo
              </span>
              <span class="rounded-full border border-neutral-200 px-3 py-1 text-xs font-medium text-neutral-600">
                {tab.data.hours} h/week
              </span>
            </div>

            <ul class="mt-8 space-y-4 border-t border-neutral-200 pt-6 text-sm text-neutral-600">
              {tab.teasers.map((teaser) => (
                <li class="flex gap-3">
                  <span class="bg-primary mt-2 size-1.5 shrink-0 rounded-full" />
                  {teaser}
                </li>
              ))}
            </ul>

            <a
              href={base + "samples/" + tab.slug}
              class="text-primary mt-8 inline-block text-sm font-semibold hover:underline"
            >
              Open full sample →
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
