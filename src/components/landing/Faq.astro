---
import Ring from "./Ring.astro";

interface Props {
  /** The /faq page supplies its own <h1>, so it turns this <h2> off. */
  heading?: boolean;
  /** FAQPage JSON-LD belongs on one URL only — the canonical /faq page. */
  schema?: boolean;
}

const { heading = true, schema = false } = Astro.props;

const base = import.meta.env.BASE_URL;

// Single source of truth: rendered as the accordion and as FAQPage JSON-LD.
const faqs = [
  {
    q: "Is my API key safe?",
    a: "Kampa has no server, so there's nowhere for us to send your key even if we wanted to. It's held in sessionStorage, cleared when you close the tab, and only ever sent to api.anthropic.com. Set a spend cap on the key and a mistake can't cost more than you decided. The code is open source — check it yourself.",
    link: {
      href: base + "guide/api-key",
      label: "The guide shows how to set a spend cap.",
    },
  },
  {
    q: "Is it really free?",
    a: "The software is free and open source — no account, no subscription, no upsell. The only cost is the AI itself, usually around €1, paid straight to Anthropic.",
  },
  {
    q: "What's a Claude API key and how do I get one?",
    a: "A token from Anthropic that lets Kampa talk to Claude on your behalf. Create an account in the Anthropic console, add a little credit, generate a key — about five minutes.",
    link: {
      href: base + "guide/api-key",
      label: "Read the step-by-step guide to getting a key.",
    },
  },
  {
    q: "What exactly do I get?",
    a: "A 30-day plan: which channels to use and which were rejected, a budget split, a week-by-week calendar with ready-to-paste copy. Export as Markdown, PDF, or .ics.",
  },
  {
    q: "Does Kampa just write content, or does it assess risk too?",
    a: "Both. General AI tools stop at generating posts and copy. Kampa also scores the plan itself against your budget, hours and market data, flags which channels are likely to waste money, and tells you whether to continue, reduce or avoid each one — before you spend anything.",
  },
  {
    q: "Does it work for my type of business?",
    a: "Built for local services, shops, cafés, online stores, freelancers and solo consultants. Weaker fit for enterprise marketing or long B2B sales cycles.",
  },
];

// Layout only: the biggest trust blocker is promoted out of the accordion into
// a callout (contract §8.1.9). Same approved copy, still in the JSON-LD below.
const TRUST_Q = "Is my API key safe?";
const trust = faqs.find((item) => item.q === TRUST_Q)!;
const accordion = faqs.filter((item) => item.q !== TRUST_Q);

// Keeps the document outline valid on /faq, where this section has no <h2>.
const TrustHeading = heading ? "h3" : "h2";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.link ? item.a + " " + item.link.label : item.a,
    },
  })),
};
---

<section id="faq" class="section">
  <div class="wrap max-w-[840px]">
    {
      heading && (
        <div class="section-head">
          <p class="eyebrow">Questions, answered</p>
          <h2>Everything before you type in an API key.</h2>
        </div>
      )
    }

    <div
      class="card-dim mb-9 grid items-start gap-5 p-[26px_28px] sm:grid-cols-[56px_1fr]"
    >
      <Ring size={56} r={23} sw={6} dash={144} offset={14} />
      <div>
        <TrustHeading class="text-[length:var(--text-h3)]">
          {trust.q}
        </TrustHeading>
        <p class="mt-2 text-[length:var(--text-sm)] text-ink-soft">{trust.a}</p>
        {
          trust.link && (
            <p class="mt-3 text-[length:var(--text-sm)]">
              <a
                href={trust.link.href}
                class="text-violet-ink font-semibold underline-offset-2 hover:underline"
              >
                {trust.link.label}
              </a>
            </p>
          )
        }
      </div>
    </div>

    {
      /* ponytail: native <details> — zero JS, keyboard and screen-reader ready */
    }
    {
      accordion.map((item) => (
        <details class="acc">
          <summary>{item.q}</summary>
          <div class="acc-body">
            <p>{item.a}</p>
            {item.link && (
              <p class="mt-3">
                <a
                  href={item.link.href}
                  class="text-violet-ink font-semibold underline-offset-2 hover:underline"
                >
                  {item.link.label}
                </a>
              </p>
            )}
          </div>
        </details>
      ))
    }
  </div>

  {
    schema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(faqSchema)}
      />
    )
  }
</section>
