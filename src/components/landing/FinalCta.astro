---
const base = import.meta.env.BASE_URL;
---

<section class="bg-neutral-950 px-6 py-24 text-white sm:py-32">
  <div class="mx-auto max-w-6xl text-center">
    <h2
      class="mx-auto max-w-3xl text-4xl font-extrabold tracking-tight text-balance sm:text-5xl"
    >
      Plan your next campaign before your coffee gets cold.
    </h2>

    <div class="mt-10">
      <a
        href={base + "app"}
        class="bg-primary text-primary-foreground inline-block rounded-lg px-6 py-3 text-base font-semibold hover:opacity-90"
      >
        Start a campaign →
      </a>
    </div>
  </div>
</section>
