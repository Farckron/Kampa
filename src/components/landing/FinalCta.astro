---
const base = import.meta.env.BASE_URL;
---

{/* On paper, not a dark band — the dark band is the pricing section. */}
<section class="py-[clamp(4.5rem,3rem+6vw,6.875rem)] text-center">
  <div class="wrap">
    <h2
      class="mx-auto max-w-[640px] text-[2rem] leading-[var(--lh-h2)] text-balance sm:text-[2.375rem]"
    >
      Plan your next campaign before your coffee gets cold.
    </h2>

    <a class="btn btn-grad mt-[30px]" href={base + "app"}>
      Start a campaign <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
