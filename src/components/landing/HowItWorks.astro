---
const steps = [
  {
    title: "Tell Kampa about your business",
    body: "Eight quick questions: what you sell, who buys it, your budget, your hours — and a few samples of your own writing so the copy sounds like you.",
  },
  {
    title: "Get your campaign",
    body: "A complete 30-day plan: 2–3 channels chosen for your constraints (and why the rest were rejected), a budget split, a weekly calendar, ready-to-paste copy — plus charts breaking down company risk and market risk, so you see the numbers behind every call, not just the verdict.",
  },
  {
    title: "Check the risks",
    body: "Before you spend anything, Kampa scores the plan against your market and flags what's likely to waste budget — a channel that doesn't fit your audience, a rejected competitor's move, a timing clash — with a plain recommendation: continue, reduce, or avoid.",
  },
  {
    title: "Export and run it",
    body: "Markdown, PDF, or straight into your calendar (.ics). The plan is yours, on your machine. Come back any time to adjust and regenerate.",
  },
];
---

<section id="how-it-works" class="section section-dim scroll-mt-20">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">How it works</p>
      <h2>Four steps, about fifteen minutes.</h2>
    </div>

    <ol class="flex flex-col">
      {
        steps.map((step, i) => (
          <li class="border-line grid grid-cols-[60px_1fr] gap-6 border-t py-[34px] last:border-b sm:grid-cols-[90px_1fr]">
            <div
              class="grad-text font-display text-[2.125rem] leading-none font-bold tracking-[-0.02em]"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, "0")}
            </div>
            <div>
              <h3 class="text-[length:var(--text-h3)] leading-[var(--lh-h3)]">
                {step.title}
              </h3>
              <p class="text-ink-soft mt-2 max-w-[560px]">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
