---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found — Kampa"
  description="This page does not exist."
  noindex
>
  <main
    id="main"
    tabindex="-1"
    class="wrap flex min-h-[72vh] scroll-mt-[72px] flex-col items-center justify-center gap-4 py-24 text-center"
  >
    <p class="eyebrow mb-0">Page not found</p>
    <h1 class="text-[length:var(--text-h1)] leading-[var(--lh-h1)]">404</h1>
    <p class="text-ink-soft text-[length:var(--text-lead)]">
      That page doesn't exist.
    </p>
    <a href={import.meta.env.BASE_URL} class="btn btn-primary mt-2"
      >Back to Kampa</a
    >
  </main>
</Base>
