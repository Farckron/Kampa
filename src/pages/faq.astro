---
import Base from "../layouts/Base.astro";
import Nav from "../components/landing/Nav.astro";
import Faq from "../components/landing/Faq.astro";
import Footer from "../components/landing/Footer.astro";
---

<Base
  title="FAQ — Kampa"
  description="How Kampa works, what a Claude API key costs, where your key is stored, and what you get out of a 30-day campaign plan."
>
  <Nav />
  <main id="main" tabindex="-1" class="scroll-mt-[72px]">
    {
      /* Same 840px column as Faq.astro below, so the eyebrow, the h1 and the
        accordion all share one left edge. */
    }
    <div class="wrap max-w-[840px] pt-16">
      <div class="max-w-[640px]">
        <p class="eyebrow">FAQ</p>
        <h1
          class="text-[length:var(--text-h1)] leading-[var(--lh-h1)] text-balance"
        >
          Questions, answered
        </h1>
        <p class="text-ink-soft mt-3.5 text-[length:var(--text-lead)]">
          What Kampa costs, what a Claude API key is, where your key lives, and
          what you walk away with.
        </p>
      </div>
    </div>
    {
      /* Canonical FAQ URL: this is the one page that carries the FAQPage JSON-LD. */
    }
    <Faq heading={false} schema />
  </main>
  <Footer />
</Base>
