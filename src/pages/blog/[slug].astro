---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/landing/Nav.astro";
import Footer from "../../components/landing/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, keywords } = entry.data;
const base = import.meta.env.BASE_URL;

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString().slice(0, 10),
  keywords: keywords.join(", "),
  author: { "@type": "Organization", name: "Kampa" },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={`${title} — Kampa`} description={description}>
  <Nav />

  <main id="main" tabindex="-1" class="section scroll-mt-[72px]">
    <div class="wrap">
      <div class="max-w-[65ch]">
        <a href={base + "blog"} class="btn btn-ghost btn-sm">
          <span aria-hidden="true">←</span> All posts
        </a>

        <h1
          class="mt-8 text-[length:var(--text-h1)] leading-[var(--lh-h1)] text-balance"
        >
          {title}
        </h1>
        <time
          datetime={date.toISOString()}
          class="mt-5 block font-mono text-[length:var(--text-mono-label)] font-semibold tracking-[var(--tracking-th)] text-ink-soft uppercase"
        >
          {
            date.toLocaleDateString("en-GB", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })
          }
        </time>

        <hr class="rule-grad mt-8 w-16" />

        <div class="prose mt-10">
          <Content />
        </div>

        <div class="mt-16 border-t border-line pt-10">
          <a href={base + "blog"} class="btn btn-ghost btn-sm">
            <span aria-hidden="true">←</span> All posts
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
</Base>

{
  /* ponytail: the same prose block lives in samples/[slug].astro. Two copies
     beat installing @tailwindcss/typography (dependency fence) or adding a
     shared class to global.css (owned by the foundation). */
}
<style>
  .prose {
    color: var(--ink);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  .prose :global(p) {
    margin: 1.15em 0 0;
  }
  .prose :global(h2) {
    margin: 2.4em 0 0;
    font-size: var(--text-h2-doc);
    line-height: 1.2;
    scroll-margin-top: 80px;
  }
  .prose :global(h3) {
    margin: 1.9em 0 0;
    font-size: var(--text-h3);
    line-height: var(--lh-h3);
    scroll-margin-top: 80px;
  }
  .prose :global(h2 + p),
  .prose :global(h3 + p) {
    margin-top: 0.55em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.15em 0 0;
    padding-left: 1.35em;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-top: 0.4em;
  }
  .prose :global(li)::marker {
    color: var(--ink-soft);
  }
  .prose :global(a) {
    color: var(--violet-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .prose :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }
  .prose :global(blockquote) {
    margin: 1.6em 0 0;
    padding: 18px 22px;
    background: var(--paper-dim);
    border-left: 3px solid var(--violet);
    border-radius: var(--radius-input);
    color: var(--ink-soft);
  }
  .prose :global(blockquote > p:first-child) {
    margin-top: 0;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--paper-dim);
    padding: 2px 6px;
    border-radius: var(--radius-chip);
  }
  .prose :global(pre) {
    margin: 1.4em 0 0;
    padding: 16px 18px;
    background: var(--paper-dim);
    border-radius: var(--radius-input);
    overflow-x: auto;
    font-size: var(--text-sm);
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: 1em;
  }
  .prose :global(hr) {
    margin: 2.6em 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  /* Fixed layout + wrapping fits the table to the column without display:block,
     which would strip the table role and lose th/td relationships in
     Chrome and Safari. */
  .prose :global(table) {
    width: 100%;
    table-layout: fixed;
    margin: 1.6em 0 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    font-weight: 600;
    letter-spacing: var(--tracking-th);
    text-transform: uppercase;
    color: var(--ink-soft);
    text-align: left;
    padding: 0 16px 10px 0;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(td) {
    padding: 12px 16px 12px 0;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
</style>
