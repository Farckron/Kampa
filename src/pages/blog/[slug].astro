---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/landing/Nav.astro";
import Footer from "../../components/landing/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, keywords } = entry.data;
const base = import.meta.env.BASE_URL;

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString().slice(0, 10),
  keywords: keywords.join(", "),
  author: { "@type": "Organization", name: "Kampa" },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={`${title} — Kampa`} description={description}>
  <Nav />

  <main class="px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <a
        href={base + "blog"}
        class="text-sm font-medium text-neutral-500 hover:text-neutral-950"
        >← All posts</a
      >

      <h1
        class="mt-6 text-4xl font-extrabold tracking-tight text-balance text-neutral-950 sm:text-5xl"
      >
        {title}
      </h1>
      <time
        datetime={date.toISOString()}
        class="mt-5 block text-sm text-neutral-500"
      >
        {
          date.toLocaleDateString("en-GB", {
            day: "numeric",
            month: "long",
            year: "numeric",
          })
        }
      </time>

      {
        /* ponytail: same hand-styled markdown wrapper as samples/[slug].astro — @tailwindcss/typography is not installed */
      }
      <div
        class="mt-12 text-neutral-600 [&_a]:text-primary [&_a]:underline [&_blockquote>p:first-child]:mt-0 [&_blockquote]:mt-6 [&_blockquote]:rounded-xl [&_blockquote]:border [&_blockquote]:border-neutral-200 [&_blockquote]:bg-neutral-50 [&_blockquote]:p-6 [&_h2]:mt-14 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-neutral-950 [&_h3]:mt-10 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-neutral-950 [&_hr]:my-12 [&_hr]:border-neutral-200 [&_li]:mt-2 [&_ol]:mt-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:mt-5 [&_p]:leading-relaxed [&_strong]:font-semibold [&_strong]:text-neutral-950 [&_table]:mt-6 [&_table]:block [&_table]:w-full [&_table]:overflow-x-auto [&_table]:border-collapse [&_table]:text-sm [&_td]:min-w-36 [&_td]:border-b [&_td]:border-neutral-200 [&_td]:px-4 [&_td]:py-3 [&_td]:align-top [&_th]:min-w-36 [&_th]:border-b [&_th]:border-neutral-200 [&_th]:px-4 [&_th]:py-3 [&_th]:text-left [&_th]:font-semibold [&_th]:text-neutral-950 [&_ul]:mt-5 [&_ul]:list-disc [&_ul]:pl-5 sm:[&_h2]:text-3xl"
      >
        <Content />
      </div>

      <div class="mt-16 border-t border-neutral-200 pt-10">
        <a
          href={base + "blog"}
          class="text-sm font-medium text-neutral-500 hover:text-neutral-950"
          >← All posts</a
        >
      </div>
    </div>
  </main>

  <Footer />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />
</Base>
