---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/landing/Nav.astro";
import Footer from "../../components/landing/Footer.astro";

const base = import.meta.env.BASE_URL;
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base
  title="Blog — Kampa"
  description="Plain notes on small business marketing: what a real budget buys, what an AI campaign costs in euros, and which channels are worth your hours."
>
  <Nav />

  <main class="px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <h1
        class="max-w-3xl text-4xl font-extrabold tracking-tight text-balance text-neutral-950 sm:text-5xl"
      >
        Blog
      </h1>
      <p class="mt-5 max-w-prose text-lg text-neutral-600">
        Marketing notes for people running a business on a real budget. No
        growth hacks, concrete numbers.
      </p>

      <ul class="mt-14 grid gap-6 lg:grid-cols-2">
        {
          posts.map((post) => (
            <li class="flex flex-col rounded-xl border border-neutral-200 bg-white p-8">
              <time
                datetime={post.data.date.toISOString()}
                class="text-xs tracking-widest text-neutral-500 uppercase"
              >
                {post.data.date.toLocaleDateString("en-GB", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                })}
              </time>
              <h2 class="mt-3 text-lg font-semibold text-balance text-neutral-950">
                {post.data.title}
              </h2>
              <p class="mt-3 text-sm text-neutral-600">
                {post.data.description}
              </p>
              <a
                href={base + "blog/" + post.id}
                class="text-primary mt-6 inline-block text-sm font-semibold hover:underline"
              >
                Read the post →
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <Footer />
</Base>
