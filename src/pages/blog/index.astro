---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/landing/Nav.astro";
import Footer from "../../components/landing/Footer.astro";

const base = import.meta.env.BASE_URL;
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base
  title="Blog — Kampa"
  description="Plain notes on small business marketing: what a real budget buys, what an AI campaign costs in euros, and which channels are worth your hours."
>
  <Nav />

  <main id="main" tabindex="-1" class="section scroll-mt-[72px]">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">
          {posts.length} {posts.length === 1 ? "post" : "posts"}
        </p>
        <h1
          class="text-[length:var(--text-h1)] leading-[var(--lh-h1)] text-balance"
        >
          Blog
        </h1>
        <p>
          Marketing notes for people running a business on a real budget. No
          growth hacks, concrete numbers.
        </p>
      </div>

      <ul class="grid gap-[var(--gap-card)] lg:grid-cols-2">
        {
          posts.map((post) => (
            <li class="card relative flex flex-col p-7 transition-colors hover:border-ink-soft">
              <time
                datetime={post.data.date.toISOString()}
                class="font-mono text-[length:var(--text-mono-label)] font-semibold tracking-[var(--tracking-th)] text-ink-soft uppercase"
              >
                {post.data.date.toLocaleDateString("en-GB", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                })}
              </time>
              <h2 class="mt-3.5 text-[length:var(--text-h3)] leading-[var(--lh-h3)] text-balance">
                {post.data.title}
              </h2>
              <p class="mt-3 text-[length:var(--text-sm)] leading-[1.5] text-ink-soft">
                {post.data.description}
              </p>
              {/* Stretched link: the whole card is the tap target, but only
                  one link lands in the accessibility tree. */}
              <a
                href={base + "blog/" + post.id}
                class="mt-auto inline-flex w-fit items-center gap-1.5 pt-6 text-[0.84375rem] font-semibold text-violet-ink after:absolute after:inset-0 after:content-[''] hover:underline"
              >
                Read the post <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <Footer />
</Base>
