---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/landing/Nav.astro";
import Footer from "../../components/landing/Footer.astro";

const base = import.meta.env.BASE_URL;
const samples = (await getCollection("samples")).sort(
  (a, b) => a.data.budget - b.data.budget,
);
---

<Base
  title="Sample plans — Kampa"
  description="Three complete 90-day campaign plans built by Kampa: a Riga coffee shop, a two-chair hair salon and a linen homeware boutique."
>
  <Nav />

  <main id="main" tabindex="-1" class="section scroll-mt-[72px]">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">
          {samples.length} {samples.length === 1 ? "plan" : "plans"}
        </p>
        <h1
          class="text-[length:var(--text-h1)] leading-[var(--lh-h1)] text-balance"
        >
          Sample plans
        </h1>
        <p>
          Three real businesses, three budgets, three complete 90-day campaigns
          — the whole output, nothing trimmed for the demo.
        </p>
      </div>

      <ul class="grid gap-[var(--gap-card)] lg:grid-cols-3">
        {
          samples.map((sample) => (
            <li class="card relative flex flex-col p-6 transition-colors hover:border-ink-soft">
              <h2 class="text-[length:var(--text-h3)] leading-[var(--lh-h3)] text-balance">
                {sample.data.title}
              </h2>
              <p class="mt-3 text-[length:var(--text-sm)] leading-[1.5] text-ink-soft">
                {sample.data.business}
              </p>

              <dl class="mt-5">
                <div class="data-row">
                  <dt>Budget</dt>
                  <dd class="amt">€{sample.data.budget} / mo</dd>
                </div>
                <div class="data-row">
                  <dt>Owner time</dt>
                  <dd class="amt">{sample.data.hours} h / week</dd>
                </div>
              </dl>

              <ul class="mt-4 flex flex-wrap gap-2">
                {sample.data.channels.map((channel) => (
                  <li class="chip">{channel}</li>
                ))}
              </ul>

              {/* Stretched link: the whole card is the tap target, but only
                  one link lands in the accessibility tree. */}
              <a
                href={base + "samples/" + sample.id}
                class="mt-auto inline-flex w-fit items-center gap-1.5 pt-6 text-[0.84375rem] font-semibold text-violet-ink after:absolute after:inset-0 after:content-[''] hover:underline"
              >
                Read the full plan <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <Footer />
</Base>
