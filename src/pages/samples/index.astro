---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/landing/Nav.astro";
import Footer from "../../components/landing/Footer.astro";

const base = import.meta.env.BASE_URL;
const samples = (await getCollection("samples")).sort(
  (a, b) => a.data.budget - b.data.budget,
);
---

<Base
  title="Sample plans — Kampa"
  description="Three complete 90-day campaign plans built by Kampa: a Riga coffee shop, a two-chair hair salon and a linen homeware boutique."
>
  <Nav />

  <main class="px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <h1
        class="max-w-3xl text-4xl font-extrabold tracking-tight text-balance text-neutral-950 sm:text-5xl"
      >
        Sample plans
      </h1>
      <p class="mt-5 max-w-prose text-lg text-neutral-600">
        Three real businesses, three budgets, three complete 90-day campaigns —
        the whole output, nothing trimmed for the demo.
      </p>

      <ul class="mt-14 grid gap-6 lg:grid-cols-3">
        {
          samples.map((sample) => (
            <li class="flex flex-col rounded-xl border border-neutral-200 bg-white p-8">
              <h2 class="text-lg font-semibold text-balance text-neutral-950">
                {sample.data.title}
              </h2>
              <p class="mt-3 text-sm text-neutral-600">
                {sample.data.business}
              </p>

              <div class="mt-6 flex flex-wrap gap-2">
                <span class="rounded-full border border-neutral-200 px-3 py-1 text-xs font-medium text-neutral-600">
                  €{sample.data.budget}/mo
                </span>
                <span class="rounded-full border border-neutral-200 px-3 py-1 text-xs font-medium text-neutral-600">
                  {sample.data.hours} h/week
                </span>
                {sample.data.channels.map((channel) => (
                  <span class="rounded-full border border-neutral-200 px-3 py-1 text-xs font-medium text-neutral-600">
                    {channel}
                  </span>
                ))}
              </div>

              <a
                href={base + "samples/" + sample.id}
                class="text-primary mt-8 inline-block text-sm font-semibold hover:underline"
              >
                Read the full plan →
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>

  <Footer />
</Base>
