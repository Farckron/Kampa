---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/landing/Nav.astro";
import Footer from "../../components/landing/Footer.astro";

export async function getStaticPaths() {
  const samples = await getCollection("samples");
  return samples.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, business, budget, hours, channels } = entry.data;
const base = import.meta.env.BASE_URL;
---

<Base title={`${title} — Kampa sample plan`} description={business}>
  <Nav />

  <main class="px-6 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl">
      <a
        href={base + "samples"}
        class="text-sm font-medium text-neutral-500 hover:text-neutral-950"
        >← All sample plans</a
      >

      <h1
        class="mt-6 max-w-4xl text-4xl font-extrabold tracking-tight text-balance text-neutral-950 sm:text-5xl"
      >
        {title}
      </h1>
      <p class="mt-5 max-w-prose text-lg text-neutral-600">{business}</p>

      <!-- Frontmatter facts, straight from the collection entry. -->
      <div
        class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-6 rounded-xl border border-neutral-200 bg-white p-6"
      >
        <div>
          <p class="text-xs tracking-widest text-neutral-500 uppercase">
            Budget
          </p>
          <p class="mt-1 text-2xl font-bold text-neutral-950">
            €{budget}<span class="text-base font-medium text-neutral-500"
              >/mo</span
            >
          </p>
        </div>
        <div>
          <p class="text-xs tracking-widest text-neutral-500 uppercase">Time</p>
          <p class="mt-1 text-2xl font-bold text-neutral-950">
            {hours}<span class="text-base font-medium text-neutral-500">
              h/week</span
            >
          </p>
        </div>
        <div>
          <p class="text-xs tracking-widest text-neutral-500 uppercase">
            Channels
          </p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {
              channels.map((channel) => (
                <li class="rounded-full border border-neutral-200 px-3 py-1 text-xs font-medium text-neutral-600">
                  {channel}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {
        /* ponytail: hand-styled markdown — @tailwindcss/typography is not installed and this is the only prose surface */
      }
      <div
        class="mt-16 max-w-3xl text-neutral-600 [&_a]:text-primary [&_a]:underline [&_blockquote>p:first-child]:mt-0 [&_blockquote]:mt-6 [&_blockquote]:rounded-xl [&_blockquote]:border [&_blockquote]:border-neutral-200 [&_blockquote]:bg-neutral-50 [&_blockquote]:p-6 [&_h2]:mt-14 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-neutral-950 [&_h3]:mt-10 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-neutral-950 [&_hr]:my-12 [&_hr]:border-neutral-200 [&_li]:mt-2 [&_ol]:mt-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:mt-5 [&_p]:leading-relaxed [&_strong]:font-semibold [&_strong]:text-neutral-950 [&_table]:mt-6 [&_table]:block [&_table]:w-full [&_table]:overflow-x-auto [&_table]:border-collapse [&_table]:text-sm [&_td]:min-w-36 [&_td]:border-b [&_td]:border-neutral-200 [&_td]:px-4 [&_td]:py-3 [&_td]:align-top [&_th]:min-w-36 [&_th]:border-b [&_th]:border-neutral-200 [&_th]:px-4 [&_th]:py-3 [&_th]:text-left [&_th]:font-semibold [&_th]:text-neutral-950 [&_ul]:mt-5 [&_ul]:list-disc [&_ul]:pl-5 sm:[&_h2]:text-3xl"
      >
        <Content />
      </div>

      <div class="mt-16 border-t border-neutral-200 pt-10">
        <p class="max-w-prose text-neutral-600">
          Your plan will look like this, built around your business, your budget
          and your hours.
        </p>
        <a
          href={base + "app"}
          class="bg-primary text-primary-foreground mt-6 inline-block rounded-lg px-6 py-3 text-base font-semibold hover:opacity-90"
        >
          Start a campaign →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Base>
