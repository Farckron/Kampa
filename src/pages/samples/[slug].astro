---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/landing/Nav.astro";
import Footer from "../../components/landing/Footer.astro";

export async function getStaticPaths() {
  const samples = await getCollection("samples");
  return samples.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, business, budget, hours, channels } = entry.data;
const base = import.meta.env.BASE_URL;
---

<Base title={`${title} — Kampa sample plan`} description={business}>
  <Nav />

  <main id="main" tabindex="-1" class="section scroll-mt-[72px]">
    <div class="wrap">
      <div class="max-w-[65ch]">
        <div class="mb-9">
          <a href={base + "samples"} class="btn btn-ghost btn-sm">
            <span aria-hidden="true">←</span> All sample plans
          </a>
        </div>

        <p class="eyebrow">Sample plan</p>
        <h1
          class="text-[length:var(--text-h1)] leading-[var(--lh-h1)] text-balance"
        >
          {title}
        </h1>
        <p
          class="mt-3.5 max-w-[38rem] text-[length:var(--text-lead)] text-ink-soft"
        >
          {business}
        </p>

        {/* Frontmatter facts, straight from the collection entry. */}
        <div class="card-grid mt-9 sm:grid-cols-3">
          <div class="snap">
            <div class="k">Marketing budget</div>
            <div class="v">€{budget} / mo</div>
          </div>
          <div class="snap">
            <div class="k">Owner time</div>
            <div class="v">{hours} h / week</div>
          </div>
          <div class="snap">
            <div class="k">Channels</div>
            <ul class="mt-2.5 flex flex-wrap gap-2">
              {channels.map((channel) => <li class="chip">{channel}</li>)}
            </ul>
          </div>
        </div>

        <div class="prose mt-14">
          <Content />
        </div>

        <div class="mt-16 border-t border-line pt-10">
          <p class="max-w-[38rem] text-[length:var(--text-lead)] text-ink-soft">
            Your plan will look like this, built around your business, your
            budget and your hours.
          </p>
          <a href={base + "app"} class="btn btn-grad mt-6">
            Start a campaign <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Base>

{
  /* ponytail: same prose block as blog/[slug].astro — see the note there. */
}
<style>
  .prose {
    color: var(--ink);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  .prose :global(p) {
    margin: 1.15em 0 0;
  }
  .prose :global(h2) {
    margin: 2.4em 0 0;
    font-size: var(--text-h2-doc);
    line-height: 1.2;
    scroll-margin-top: 80px;
  }
  .prose :global(h3) {
    margin: 1.9em 0 0;
    font-size: var(--text-h3);
    line-height: var(--lh-h3);
    scroll-margin-top: 80px;
  }
  .prose :global(h2 + p),
  .prose :global(h3 + p) {
    margin-top: 0.55em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.15em 0 0;
    padding-left: 1.35em;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-top: 0.4em;
  }
  .prose :global(li)::marker {
    color: var(--ink-soft);
  }
  .prose :global(a) {
    color: var(--violet-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .prose :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }
  .prose :global(blockquote) {
    margin: 1.6em 0 0;
    padding: 18px 22px;
    background: var(--paper-dim);
    border-left: 3px solid var(--violet);
    border-radius: var(--radius-input);
    color: var(--ink-soft);
  }
  .prose :global(blockquote > p:first-child) {
    margin-top: 0;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--paper-dim);
    padding: 2px 6px;
    border-radius: var(--radius-chip);
  }
  .prose :global(pre) {
    margin: 1.4em 0 0;
    padding: 16px 18px;
    background: var(--paper-dim);
    border-radius: var(--radius-input);
    overflow-x: auto;
    font-size: var(--text-sm);
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: 1em;
  }
  .prose :global(hr) {
    margin: 2.6em 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  /* Fixed layout + wrapping fits the table to the column without display:block,
     which would strip the table role and lose th/td relationships in
     Chrome and Safari. */
  .prose :global(table) {
    width: 100%;
    table-layout: fixed;
    margin: 1.6em 0 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    font-weight: 600;
    letter-spacing: var(--tracking-th);
    text-transform: uppercase;
    color: var(--ink-soft);
    text-align: left;
    padding: 0 16px 10px 0;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(td) {
    padding: 12px 16px 12px 0;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
</style>
