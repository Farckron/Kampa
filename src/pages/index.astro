---
import Base from "../layouts/Base.astro";
import Nav from "../components/landing/Nav.astro";
import Hero from "../components/landing/Hero.astro";
import WhoItsFor from "../components/landing/WhoItsFor.astro";
import HowItWorks from "../components/landing/HowItWorks.astro";
import RiskCheck from "../components/landing/RiskCheck.astro";
import Samples from "../components/landing/Samples.astro";
import Features from "../components/landing/Features.astro";
import Comparison from "../components/landing/Comparison.astro";
import Pricing from "../components/landing/Pricing.astro";
import Faq from "../components/landing/Faq.astro";
import FinalCta from "../components/landing/FinalCta.astro";
import Footer from "../components/landing/Footer.astro";

const base = import.meta.env.BASE_URL;

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Kampa",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  description:
    "Free browser-based AI campaign planner: answer 8 questions, get a complete 30-day marketing campaign, risk-checked before you spend. Bring your own Claude API key.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR",
  },
};
---

<Base
  title="Kampa — AI campaign planner for small businesses"
  description="Answer 8 questions, get a complete 30-day marketing campaign: channel plan, weekly calendar, ready-to-paste copy — risk-checked before you spend. Free — bring your own Claude API key."
>
  <Nav />
  <main id="main" tabindex="-1" class="scroll-mt-[72px]">
    <Hero />
    <WhoItsFor />
    <HowItWorks />
    <RiskCheck />
    <Samples />
    <Features />
    <Comparison />
    <Pricing />
    <Faq />
    <FinalCta />
  </main>
  <Footer />

  {
    /* Revealed past the fold by a scroll-driven CSS animation (global.css) —
       no scroll listener, no script. Last in the DOM so it is also last in the
       tab order. */
  }
  <div class="sticky-cta">
    <div class="wrap">
      <p class="msg">
        <b class="font-semibold">Start a campaign</b><span
          >~€1 · 15 minutes · no signup</span
        >
      </p>
      <a class="btn btn-grad btn-sm" href={base + "app"}>
        Start a campaign <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(appSchema)}
  />
</Base>
