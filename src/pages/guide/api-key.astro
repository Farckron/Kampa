---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/landing/Nav.astro";
import Footer from "../../components/landing/Footer.astro";

const base = import.meta.env.BASE_URL;

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "Get a Claude API key in 90 seconds",
  description:
    "Create a spend-capped Anthropic API key and paste it into Kampa. Five steps, about 90 seconds.",
  totalTime: "PT2M",
  step: [
    {
      "@type": "HowToStep",
      position: 1,
      name: "Create an account",
      text: "Go to console.anthropic.com and sign up with your email. This is Anthropic's own console — the company that makes Claude.",
    },
    {
      "@type": "HowToStep",
      position: 2,
      name: "Add billing",
      text: "Anthropic requires a payment method before the API works. $5 of credit covers several campaigns.",
    },
    {
      "@type": "HowToStep",
      position: 3,
      name: "Create an API key",
      text: "Go to Settings → API keys → Create key. Name it kampa and copy it — the key is shown once.",
    },
    {
      "@type": "HowToStep",
      position: 4,
      name: "Set a spend limit",
      text: "Go to Settings → Limits and cap your monthly spend, for example $10. The key can never cost more than you chose.",
    },
    {
      "@type": "HowToStep",
      position: 5,
      name: "Paste it into Kampa",
      text: "Open the Kampa app and paste the key. It stays in your browser and you can remove it with the Clear key button any time.",
    },
  ],
};
---

<Base
  title="Get a Claude API key in 90 seconds — Kampa"
  description="Step-by-step: create an Anthropic account, add billing, create an API key, cap your monthly spend, and paste the key into Kampa. The key never leaves your browser."
>
  <Nav />

  <main id="main" tabindex="-1" class="section scroll-mt-[72px]">
    {/* Same gutter as the nav (.wrap); the inner column keeps the measure. */}
    <div class="wrap">
      <div class="max-w-[65ch]">
        <p class="eyebrow">Guide</p>
        <h1
          class="max-w-[16ch] text-[length:var(--text-h1)] leading-[var(--lh-h1)] text-balance"
        >
          Get a Claude API key in 90 seconds
        </h1>
        <div
          class="mt-6 max-w-[38rem] space-y-4 text-[length:var(--text-lead)] text-ink-soft"
        >
          <p>
            Kampa is free software. There is no subscription and no account,
            because there is no server — the AI runs on your own Anthropic
            account, billed directly to you. A full 30-day campaign costs about
            €1.
          </p>
          <p>
            That means you need one thing before you start: an API key. Here is
            how to get one, with a spend cap so it can never surprise you.
          </p>
        </div>

        {/* The <ol> carries the numbering; the big numerals are decoration. */}
        <ol class="mt-14 border-t border-line">
          <li
            class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-5 border-b border-line py-9 sm:grid-cols-[5rem_minmax(0,1fr)]"
          >
            <span
              class="grad-text font-display text-[2.125rem] leading-none font-bold"
              aria-hidden="true">01</span
            >
            <div>
              <h2 class="text-[length:var(--text-h3)]">Create an account</h2>
              <p class="mt-2.5 max-w-[36rem] text-ink-soft">
                Sign up at{" "}
                <a
                  href="https://console.anthropic.com"
                  target="_blank"
                  rel="noopener nofollow"
                  class="font-medium text-violet-ink underline underline-offset-4"
                  >console.anthropic.com</a
                >. That is Anthropic's own console — the company behind Claude.
                Email and a password is all it takes.
              </p>

              <div aria-hidden="true" class="card-dim mt-5 max-w-[24rem] p-3.5">
                <div
                  class="flex items-center gap-2 rounded-[var(--radius-chip)] border border-line bg-card px-3 py-2 font-mono text-[length:var(--text-xs)] text-ink-soft"
                >
                  <span class="size-1.5 shrink-0 rounded-full bg-ink-faint"
                  ></span>
                  console.anthropic.com
                </div>
              </div>
            </div>
          </li>

          <li
            class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-5 border-b border-line py-9 sm:grid-cols-[5rem_minmax(0,1fr)]"
          >
            <span
              class="grad-text font-display text-[2.125rem] leading-none font-bold"
              aria-hidden="true">02</span
            >
            <div>
              <h2 class="text-[length:var(--text-h3)]">
                Add billing — minimum credit
              </h2>
              <p class="mt-2.5 max-w-[36rem] text-ink-soft">
                Anthropic requires a payment method before the API responds. Add
                the smallest amount: $5 of credit covers several campaigns. You
                are buying credit, not a subscription.
              </p>

              <div aria-hidden="true" class="card-dim mt-5 max-w-[24rem] p-4">
                <div
                  class="flex items-center justify-between text-[length:var(--text-sm)]"
                >
                  <span class="text-ink-soft">Credit balance</span>
                  <span class="font-mono font-semibold">$5.00</span>
                </div>
                <div class="bar-track mt-3">
                  <div class="bar-fill w-1/5"></div>
                </div>
                <p class="mt-3 text-[length:var(--text-xs)] text-ink-soft">
                  ≈ 5 campaigns at ~€1 each
                </p>
              </div>
            </div>
          </li>

          <li
            class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-5 border-b border-line py-9 sm:grid-cols-[5rem_minmax(0,1fr)]"
          >
            <span
              class="grad-text font-display text-[2.125rem] leading-none font-bold"
              aria-hidden="true">03</span
            >
            <div>
              <h2 class="text-[length:var(--text-h3)]">Create an API key</h2>
              <p class="mt-2.5 max-w-[36rem] text-ink-soft">
                In the console go to <b class="font-semibold text-ink"
                  >Settings → API keys → Create key</b
                >. Name it <b class="font-semibold text-ink">kampa</b> so you can
                tell later what it is for. Copy it right away — the key is shown once.
              </p>

              <div aria-hidden="true" class="card-dim mt-5 max-w-[24rem] p-4">
                <p class="mono-label mb-2">Key name</p>
                <div
                  class="rounded-[var(--radius-input)] border border-line bg-card px-3 py-2 text-[length:var(--text-sm)]"
                >
                  kampa
                </div>
                <div class="mt-3 inline-flex">
                  <span class="btn btn-grad btn-sm">Create key</span>
                </div>
              </div>
            </div>
          </li>

          {
            /* Step 4 carries the money risk — gradient edge + violet callout. */
          }
          <li
            class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-5 border-b border-line py-9 sm:grid-cols-[5rem_minmax(0,1fr)]"
          >
            <span
              class="grad-text font-display text-[2.125rem] leading-none font-bold"
              aria-hidden="true">04</span
            >
            <div class="card edge-grad py-6 pr-6">
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-[length:var(--text-h3)]">Set a spend limit</h2>
                <span class="badge-mono">Do not skip</span>
              </div>
              <p class="mt-2.5 max-w-[36rem] text-ink-soft">
                Go to <b class="font-semibold text-ink">Settings → Limits</b> and
                cap your monthly spend — $10 is plenty. The key can never cost more
                than you chose. A capped key is the safe way to use any bring-your-own-key
                tool, Kampa included.
              </p>

              <p class="callout callout-violet mt-5 max-w-[36rem]">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="mt-px shrink-0"
                >
                  <path d="M12 9v4"></path>
                  <path
                    d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"
                  ></path>
                  <path d="M12 17h.01"></path>
                </svg>
                <span
                  >Hard ceiling. Requests stop when it is reached — that is what
                  keeps a bring-your-own-key tool from surprising you.</span
                >
              </p>

              <div aria-hidden="true" class="card-dim mt-4 max-w-[24rem] p-4">
                <p class="mono-label mb-2">Monthly spend limit</p>
                <div
                  class="flex items-center gap-2 rounded-[var(--radius-input)] border border-violet bg-card px-3 py-2 font-mono text-[length:var(--text-sm)]"
                >
                  <span class="text-ink-soft">$</span>10.00
                </div>
              </div>
            </div>
          </li>

          <li
            class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-5 border-b border-line py-9 sm:grid-cols-[5rem_minmax(0,1fr)]"
          >
            <span
              class="grad-text font-display text-[2.125rem] leading-none font-bold"
              aria-hidden="true">05</span
            >
            <div>
              <h2 class="text-[length:var(--text-h3)]">Paste it into Kampa</h2>
              <p class="mt-2.5 max-w-[36rem] text-ink-soft">
                Open the app and paste the key into the field. Use the <b
                  class="font-semibold text-ink">Clear key</b
                > button any time to remove it.
              </p>

              <p class="callout callout-violet mt-5 max-w-[36rem]">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="mt-px shrink-0"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span
                  >It is stored in your browser and sent straight to Anthropic —
                  never to us.</span
                >
              </p>

              <div aria-hidden="true" class="card-dim mt-4 max-w-[24rem] p-4">
                <p class="mono-label mb-2">Anthropic API key</p>
                <div
                  class="truncate rounded-[var(--radius-input)] border border-line bg-card px-3 py-2 font-mono text-[length:var(--text-sm)] text-ink-soft"
                >
                  sk-ant-••••••••••••••••••••
                </div>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <span class="btn btn-grad btn-sm">Save key</span>
                  <span class="btn btn-ghost btn-sm">Clear key</span>
                </div>
              </div>

              <a href={base + "app"} class="btn btn-grad mt-7">
                Open the app <span aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        </ol>

        <section class="mt-16 max-w-[38rem]">
          <h2 class="text-[length:var(--text-h2-doc)]">Changed your mind?</h2>
          <p class="mt-3 text-ink-soft">
            You can rotate or revoke the key any time in the Anthropic console,
            and the old one stops working immediately. Kampa never sees it —
            there is no server to send it to.
          </p>
          <p class="mt-5 text-[length:var(--text-sm)] text-ink-soft">
            Still unsure? The <a
              href={base + "faq"}
              class="font-medium text-violet-ink underline underline-offset-4"
              >FAQ</a
            > covers cost, privacy and what happens to your answers.
          </p>
        </section>
      </div>
    </div>
  </main>

  <Footer />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(howToSchema)}
  />
</Base>
